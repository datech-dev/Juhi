# Juhi API - Production Environment Variables Example
APP_ENV=production
DEBUG=false
PROJECT_NAME="Juhi AI Companion"
API_V1_PREFIX=/api/v1
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_32_BYTES_HEX
ALLOWED_ORIGINS=["https://juhi.app","https://chat.juhi.app"]

# Database Configuration (PostgreSQL 16 on VPS / Cloud SQL)
POSTGRES_USER=juhi_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_DB_PASSWORD
POSTGRES_DB=juhi_prod
DATABASE_URL=postgresql+asyncpg://juhi_prod_user:REPLACE_WITH_SECURE_DB_PASSWORD@postgres:5432/juhi_prod
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Authentication & Firebase
FIREBASE_PROJECT_ID=juhi-companion
ENABLE_DEV_AUTH_BYPASS=false
DEV_AUTH_SECRET=

# AI Provider Configuration
AI_PROVIDER=anthropic
AI_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
VENICE_API_KEY=

# Security & Limits
RATE_LIMIT_PER_MINUTE=60
