# Juhi API - Environment Variables Example
APP_ENV=development
DEBUG=true
PROJECT_NAME="Juhi AI Companion"
API_V1_PREFIX=/api/v1
SECRET_KEY=change_me_to_a_secure_random_string_min_32_chars
ALLOWED_ORIGINS=["*"]

# Database Configuration (PostgreSQL 16)
# Local SQLite fallback for unit tests: sqlite+aiosqlite:///./test.db
DATABASE_URL=postgresql+asyncpg://juhi_user:juhi_password@localhost:5432/juhi_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Firebase
FIREBASE_PROJECT_ID=juhi-companion
ENABLE_DEV_AUTH_BYPASS=true
DEV_AUTH_SECRET=dev_test_secret_for_local_mocking

# AI Provider Configuration
# Options: 'mock', 'openai', 'anthropic', 'venice'
AI_PROVIDER=mock
AI_MODEL=mock-companion-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VENICE_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
